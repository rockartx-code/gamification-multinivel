# Variables de entorno del backend. Copiar y rellenar por entorno; ninguna de
# estas debe llevar valor por defecto en el código fuente.

# ── Datos ────────────────────────────────────────────────────────────────────
TABLE_NAME=multinivel
AWS_REGION=us-east-1
BUCKET_NAME=findingu-ventas

# ── Seguridad ────────────────────────────────────────────────────────────────
# Token maestro con todos los privilegios. Si NO se define, no existe ningún
# acceso de superadmin (recomendado en producción). Antes había uno fijo en el
# código, por lo que el valor histórico debe considerarse comprometido y jamás
# reutilizarse.
SUPERADMIN_TOKEN=

# Coste del derivado PBKDF2 de las contraseñas. Subirlo invalida nada: los
# hashes guardan sus propias iteraciones.
PASSWORD_HASH_ITERATIONS=210000

# Vigencia de las sesiones, en segundos (30 días por defecto). Requiere tener
# habilitado el TTL de DynamoDB sobre el atributo `ttl` de la tabla.
SESSION_TTL_SECONDS=2592000

# Cuentas de demostración con contraseña fija. Dejar SIN definir en producción.
DEMO_LOGIN_ENABLED=
DEMO_ADMIN_PASSWORD=
DEMO_CLIENTE_PASSWORD=

# ── Comportamiento ───────────────────────────────────────────────────────────
# Vigencia de la caché en memoria de la configuración del negocio. Marca cuánto
# tarda en propagarse un cambio de config a los contenedores tibios.
APP_CONFIG_TTL_SECONDS=60

FRONTEND_BASE_URL=https://www.findingu.com.mx
SES_FROM_EMAIL=info@findingu.com.mx

# ── Envíos (Envia.com) ───────────────────────────────────────────────────────
ENVIA_API_KEY=
SHIPPING_ORIGIN_NAME=Warehouse MX
SHIPPING_ORIGIN_PHONE=8180000000
SHIPPING_ORIGIN_STREET=Av. Principal
SHIPPING_ORIGIN_NUMBER=1
SHIPPING_ORIGIN_CITY=Monterrey
SHIPPING_ORIGIN_STATE=NL
SHIPPING_ORIGIN_POSTAL_CODE=64060

# URL del API de envíos. Test por defecto; en producción apuntar a la de prod.
ENVIA_API_URL=https://api-test.envia.com/ship/rate/
# Paquete D · paquetería integrada (carriers.py): generación de guía y rastreo por
# consulta programable. Los nombres de endpoint se confirman con la documentación
# vigente de Envia antes de desplegar.
ENVIA_GENERATE_URL=https://api-test.envia.com/ship/generate/
ENVIA_TRACK_URL=https://api-test.envia.com/ship/generaltrack/
# URL pública del API (sin barra final) para el enlace "Sí, ya llegó" del correo
# "¿te llegó tu pedido?". Vacía → el botón lleva al seguimiento del pedido.
API_BASE_URL=

# ── Pagos (Mercado Pago) ─────────────────────────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=

# ── Orquestación ─────────────────────────────────────────────────────────────
# ARN de la máquina de estados que procesa comisiones al pagar/entregar.
ORDER_FULFILLMENT_SFN_ARN=

# ── Analítica (opcional) ─────────────────────────────────────────────────────
# Base de datos de Athena para el sync a S3 Tables. Vacío desactiva el sync.
ATHENA_DATABASE=

# ── Esquema del mes contable de comisiones ───────────────────────────────────
# "off"  (por defecto) item único con la lista `ledger` dentro
# "dual" escribe en ambos esquemas y lee del original — fase de transición
# "rows" un item por fila; sin techo de 400 KB ni contención entre escritores
# Migrar con: python3 tools/migrate_ledger_rows.py --apply
LEDGER_ROW_SCHEME=off
